<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Vayu_Desktop.Pages.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Vayu_Desktop.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Security"
                   Style="{StaticResource TitleLargeTextBlockStyle}" />

        <StackPanel Grid.Row="1" Spacing="12">
            <TextBlock Text="Gemini API key"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Name="GeminiStatus"
                       Text="Status: checking…"
                       Opacity="0.8" />
            <TextBlock Text="The Gemini key is never displayed or logged by Vayu, only its presence and source."
                       Opacity="0.7"
                       TextWrapping="Wrap" />

            <TextBlock Text="Local audit log"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="0,12,0,0" />
            <TextBlock x:Name="AuditPathText"
                       Opacity="0.8"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
