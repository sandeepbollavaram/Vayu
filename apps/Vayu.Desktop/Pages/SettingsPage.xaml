<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Vayu_Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:Vayu_Desktop.Services"
    xmlns:online="using:Vayu.AI.Online"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="36,28,36,28" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="SETTINGS" Style="{StaticResource VayuTitleText}" FontSize="32" />
                <TextBlock Text="Configure AI mode, providers, voice, and trust. Every change is opt-in and audit-logged." Style="{StaticResource VayuSubtitleText}" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- AI Mode -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource VayuGlassCard}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="3" Height="14" Background="{StaticResource VayuAccentCyanBrush}" />
                            <TextBlock Style="{StaticResource VayuSectionText}" Text="AI MODE" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="AiModeProviderText" Style="{StaticResource VayuBodyText}" Text="Provider: rule-based parser" FontSize="18" />
                        <RadioButton x:Name="ModeRuleBasedRadio" Content="Rule-based (deterministic, no model)"
                                     GroupName="AiMode" Checked="OnAiModeChecked" Tag="rulebased" IsChecked="True" />
                        <RadioButton x:Name="ModeOfflineRadio" Content="Offline AI (Ollama local, rule-based fallback)"
                                     GroupName="AiMode" Checked="OnAiModeChecked" Tag="offline" IsEnabled="False" />
                        <RadioButton x:Name="ModeOnlineRadio" Content="Online Gemini (cloud, consent each request)"
                                     GroupName="AiMode" Checked="OnAiModeChecked" Tag="online" IsEnabled="False" />
                        <RadioButton x:Name="ModeHybridRadio" Content="Hybrid (local first, Gemini with consent fallback)"
                                     GroupName="AiMode" Checked="OnAiModeChecked" Tag="hybrid" IsEnabled="False" />
                        <TextBlock x:Name="AiModeHint" Style="{StaticResource VayuMutedText}" TextWrapping="Wrap"
                                   Text="Every AI mode is opt-in. Cloud calls ask for consent every time. The model only proposes a plan — every action still passes through the Permission Guard, and Vayu falls back to the rule-based parser whenever a model is unavailable, unsure, or unsafe." />
                    </StackPanel>
                </Border>

                <!-- Setup wizard -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource VayuGlassCard}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="3" Height="14" Background="{StaticResource VayuAccentTealBrush}" />
                            <TextBlock Style="{StaticResource VayuSectionText}" Text="SETUP DASHBOARD" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource VayuBodyText}" Text="Walks you through:" />
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="·  Storage and workspace paths" />
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="·  Local AI detection and model download (with permission)" />
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="·  Online AI provider key (Gemini, OpenAI, Anthropic, …)" />
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="·  Voice and Trust Center — every step is skippable." />
                    </StackPanel>
                </Border>

                <!-- Developer mode -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource VayuGlassCard}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="3" Height="14" Background="{StaticResource VayuAccentVioletBrush}" />
                            <TextBlock Style="{StaticResource VayuSectionText}" Text="DEVELOPER MODE" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource VayuBodyText}" Text="Safe routing is enabled." />
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="·  Audit log: enabled" />
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="·  Cloud AI: disabled by default" />
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="·  Verbose logging: available" />
                        <ToggleSwitch x:Name="VerboseToggle" IsEnabled="False" OffContent="Off" OnContent="On" />
                    </StackPanel>
                </Border>

                <!-- Future providers -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource VayuGlassCard}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="3" Height="14" Background="{StaticResource VayuAccentAmberBrush}" />
                            <TextBlock Style="{StaticResource VayuSectionText}" Text="PROVIDER REGISTRY" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Inline chip flow (StackPanel rows; no CommunityToolkit dependency) -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource VayuChip}"><TextBlock Style="{StaticResource VayuChipText}" Text="OLLAMA" /></Border>
                            <Border Style="{StaticResource VayuChipTeal}"><TextBlock Style="{StaticResource VayuChipText}" Text="GEMINI" /></Border>
                            <Border Style="{StaticResource VayuChip}"><TextBlock Style="{StaticResource VayuChipText}" Text="OPENAI" /></Border>
                            <Border Style="{StaticResource VayuChipTeal}"><TextBlock Style="{StaticResource VayuChipText}" Text="ANTHROPIC" /></Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource VayuChipViolet}"><TextBlock Style="{StaticResource VayuChipText}" Text="DEEPSEEK" /></Border>
                            <Border Style="{StaticResource VayuChipViolet}"><TextBlock Style="{StaticResource VayuChipText}" Text="KIMI" /></Border>
                            <Border Style="{StaticResource VayuChipAmber}"><TextBlock Style="{StaticResource VayuChipText}" Text="OPENROUTER" /></Border>
                            <Border Style="{StaticResource VayuChip}"><TextBlock Style="{StaticResource VayuChipText}" Text="CUSTOM OAI-COMPAT" /></Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="See docs/AI_PROVIDER_REGISTRY.md for the full provider catalog." />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- M2.3: Offline AI status card -->
            <Border Grid.Row="2" Style="{StaticResource VayuGlassCard}">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <Border Width="3" Height="14" Background="{StaticResource VayuAccentCyanBrush}" />
                            <TextBlock Style="{StaticResource VayuSectionText}" Text="OFFLINE AI · OLLAMA" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="RefreshOfflineAiButton"
                                Content="Refresh"
                                Click="OnRefreshOfflineAiClick" />
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="Local AI is OFF by default. Detection is read-only — no installs, no model downloads." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource VayuMutedText}" Text="Endpoint:" />
                            <TextBlock x:Name="EndpointDisplayText" Style="{StaticResource VayuBodyText}" Text="http://localhost:11434" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource VayuMutedText}" Text="Executable on PATH:" />
                            <TextBlock x:Name="ExecutableStatusText" Style="{StaticResource VayuBodyText}" Text="Not yet probed" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource VayuMutedText}" Text="Server reachable:" />
                            <TextBlock x:Name="EndpointStatusText" Style="{StaticResource VayuBodyText}" Text="Not yet probed" />
                        </StackPanel>
                        <TextBlock x:Name="DetectionMessageText" Style="{StaticResource VayuMutedText}" Text="Click Refresh to probe the local Ollama runtime." TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource VayuMutedText}" Text="Curated model catalog — install/missing reflects Ollama's /api/tags response." />
                        </StackPanel>
                        <TextBlock x:Name="CuratedSummaryText" Style="{StaticResource VayuBodyText}" Text="Installed curated models: 0 / 3" />
                        <ItemsControl x:Name="ModelsItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="svc:LocalModelRow">
                                    <Border Margin="0,4,0,4" Padding="16,12,16,12" CornerRadius="8"
                                            Background="{StaticResource VayuGlassFill}"
                                            BorderBrush="{StaticResource VayuGlassStroke}" BorderThickness="1">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Style="{StaticResource VayuBodyText}" FontSize="16" Text="{x:Bind DisplayName}" VerticalAlignment="Center" />
                                                    <TextBlock Style="{StaticResource VayuMutedText}" Text="{x:Bind ModelTag}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource VayuMutedText}" Text="{x:Bind Description}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource VayuMutedText}" Text="{x:Bind HardwareNote}" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind MetadataVisibility, Mode=OneWay}">
                                                    <Border Style="{StaticResource VayuChipTeal}"><TextBlock Style="{StaticResource VayuChipText}" Text="{x:Bind DisplaySize, Mode=OneWay}" /></Border>
                                                    <Border Style="{StaticResource VayuChip}"><TextBlock Style="{StaticResource VayuChipText}" Text="{x:Bind ParameterSize, Mode=OneWay}" /></Border>
                                                    <Border Style="{StaticResource VayuChip}"><TextBlock Style="{StaticResource VayuChipText}" Text="{x:Bind FamilyLabel, Mode=OneWay}" /></Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource VayuChip}" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource VayuChipText}" Text="{x:Bind StatusText, Mode=OneWay}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- M2.5: First Run Setup launcher -->
            <Border Grid.Row="3" Style="{StaticResource VayuGlassCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="3" Height="14" Background="{StaticResource VayuAccentTealBrush}" />
                            <TextBlock Style="{StaticResource VayuSectionText}" Text="SETUP DASHBOARD" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource VayuBodyText}" Text="Open the guided Setup Dashboard." />
                        <TextBlock Style="{StaticResource VayuMutedText}" TextWrapping="Wrap"
                                   Text="Walks through storage, AI mode, Local AI detection, model download, Online AI keys, voice, and the Trust Center. Model downloads always ask for permission; nothing installs silently." />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="OpenFirstRunSetupButton" Content="Open Setup Dashboard"
                            VerticalAlignment="Center" Click="OnOpenFirstRunSetupClick"
                            Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Border>

            <!-- M3.3: Online AI · Gemini key setup -->
            <Border Grid.Row="4" Style="{StaticResource VayuGlassCard}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="3" Height="14" Background="{StaticResource VayuAccentBlueBrush}" />
                        <TextBlock Style="{StaticResource VayuSectionText}" Text="ONLINE AI · GEMINI" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource VayuMutedText}" TextWrapping="Wrap"
                               Text="Gemini is one optional online provider — cloud AI stays off by default. Your key is stored in Windows Credential Manager (or a DPAPI-encrypted fallback), never in a plain file, never logged, and never shown again after you save it." />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="Status:" />
                        <Border x:Name="GeminiKeyStatusBadge" Style="{StaticResource VayuChip}">
                            <TextBlock x:Name="GeminiKeyStatusText" Style="{StaticResource VayuChipText}" Text="CHECKING…" />
                        </Border>
                    </StackPanel>

                    <PasswordBox x:Name="GeminiKeyInput"
                                 PlaceholderText="Paste your Gemini API key"
                                 MaxWidth="520" HorizontalAlignment="Left" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="SaveGeminiKeyButton" Content="Save key"
                                Click="OnSaveGeminiKeyClick" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="RemoveGeminiKeyButton" Content="Remove key"
                                Click="OnRemoveGeminiKeyClick" IsEnabled="False" />
                        <Button x:Name="TestGeminiKeyButton" Content="Test key"
                                Click="OnTestGeminiKeyClick" IsEnabled="False" />
                    </StackPanel>

                    <TextBlock x:Name="GeminiKeyMessageText" Style="{StaticResource VayuMutedText}" TextWrapping="Wrap" Text="" />
                </StackPanel>
            </Border>

            <!-- M3.6: Online Provider Registry -->
            <Border Grid.Row="5" Style="{StaticResource VayuGlassCard}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="3" Height="14" Background="{StaticResource VayuAccentVioletBrush}" />
                        <TextBlock Style="{StaticResource VayuSectionText}" Text="ONLINE PROVIDER REGISTRY" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource VayuMutedText}" TextWrapping="Wrap"
                               Text="Choose optional cloud providers. Gemini works now; other connectors are planned. Cloud calls require Allow once consent — Vayu is not tied to any single vendor." />

                    <ItemsControl x:Name="ProviderRegistryItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="online:ProviderCardViewModel">
                                <Border Margin="0,4,0,4" Padding="16,12,16,12" CornerRadius="8"
                                        Background="{StaticResource VayuGlassFill}"
                                        BorderBrush="{StaticResource VayuGlassStroke}" BorderThickness="1">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Style="{StaticResource VayuBodyText}" FontSize="16" Text="{x:Bind DisplayName}" VerticalAlignment="Center" />
                                                <TextBlock Style="{StaticResource VayuMutedText}" Text="{x:Bind ProviderId}" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource VayuChip}"><TextBlock Style="{StaticResource VayuChipText}" Text="{x:Bind KindLabel}" /></Border>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{x:Bind CapabilityLabels}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border Style="{StaticResource VayuChipTeal}"><TextBlock Style="{StaticResource VayuChipText}" Text="{x:Bind}" /></Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="180">
                                            <Border Style="{StaticResource VayuChip}" HorizontalAlignment="Right">
                                                <TextBlock Style="{StaticResource VayuChipText}" Text="{x:Bind StatusLabel}" />
                                            </Border>
                                            <TextBlock Style="{StaticResource VayuMutedText}" Text="{x:Bind ActionLabel}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Voice Setup -->
            <Border Grid.Row="6" Style="{StaticResource VayuGlassCard}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="3" Height="14" Background="{StaticResource VayuAccentVioletBrush}" />
                        <TextBlock Style="{StaticResource VayuSectionText}" Text="VOICE SETUP" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource VayuMutedText}" TextWrapping="Wrap"
                               Text="Voice is opt-in and never always-listening. Push-to-talk captures only while you hold it; the control lives on the Home page." />
                    <TextBlock x:Name="VoiceMicStatusText" Style="{StaticResource VayuMutedText}" TextWrapping="Wrap"
                               Text="Microphone: checking…" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource VayuChipTeal}"><TextBlock Style="{StaticResource VayuChipText}" Text="PUSH-TO-TALK · READY" /></Border>
                        <Border Style="{StaticResource VayuChip}"><TextBlock Style="{StaticResource VayuChipText}" Text="LOCAL STT · WHISPER" /></Border>
                        <Border Style="{StaticResource VayuChipAmber}"><TextBlock Style="{StaticResource VayuChipText}" Text="CLOUD STT · DISABLED" /></Border>
                    </StackPanel>
                    <TextBlock x:Name="VoiceSttStatusText" Style="{StaticResource VayuMutedText}" TextWrapping="Wrap"
                               Text="Local STT: checking…" />

                    <!-- Local STT model path configuration -->
                    <TextBlock Style="{StaticResource VayuMutedText}" Text="Local STT model file (e.g. a Whisper GGUF). Stored locally; no secrets." TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="SttModelPathBox"
                                 PlaceholderText="C:\models\ggml-base.en.bin" />
                        <Button Grid.Column="1" x:Name="SaveSttModelButton" Content="Save"
                                Click="OnSaveSttModelClick" Style="{StaticResource AccentButtonStyle}" />
                        <Button Grid.Column="2" x:Name="DisableSttButton" Content="Disable"
                                Click="OnDisableSttClick" />
                    </Grid>
                    <TextBlock x:Name="SttModelMessageText" Style="{StaticResource VayuMutedText}" TextWrapping="Wrap" Text="" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource VayuChip}"><TextBlock Style="{StaticResource VayuChipText}" Text="SYSTEM TTS · READY" /></Border>
                        <Border Style="{StaticResource VayuChipAmber}"><TextBlock Style="{StaticResource VayuChipText}" Text="CLOUD TTS · DISABLED" /></Border>
                    </StackPanel>
                    <ToggleSwitch x:Name="TtsToggle"
                                  Header="Enable short spoken responses (System TTS)"
                                  OffContent="Off" OnContent="On"
                                  Toggled="OnTtsToggled" />
                    <TextBlock x:Name="VoiceTtsStatusText" Style="{StaticResource VayuMutedText}" TextWrapping="Wrap"
                               Text="Text-to-speech: off by default. Short neutral phrases only — Vayu never speaks secrets or user content." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource VayuChip}"><TextBlock Style="{StaticResource VayuChipText}" Text="WAKE WORD · PLANNED" /></Border>
                        <Border Style="{StaticResource VayuChip}"><TextBlock Style="{StaticResource VayuChipText}" Text="CLAP TRIGGER · PLANNED" /></Border>
                        <Border Style="{StaticResource VayuChipAmber}"><TextBlock Style="{StaticResource VayuChipText}" Text="ALWAYS-LISTENING · OFF" /></Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
