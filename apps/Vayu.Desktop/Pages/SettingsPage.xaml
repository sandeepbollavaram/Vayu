<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Vayu_Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:Vayu_Desktop.Services"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="36,28,36,28" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="SETTINGS" Style="{StaticResource VayuTitleText}" FontSize="32" />
                <TextBlock Text="Read-only at M1. Editable surfaces land alongside the first-run wizard in M2." Style="{StaticResource VayuSubtitleText}" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- AI Mode -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource VayuGlassCard}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="3" Height="14" Background="{StaticResource VayuAccentCyanBrush}" />
                            <TextBlock Style="{StaticResource VayuSectionText}" Text="AI MODE" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource VayuBodyText}" Text="Offline" FontSize="20" />
                        <TextBlock x:Name="AiModeProviderText" Style="{StaticResource VayuMutedText}" Text="Provider: rule-based parser" />
                        <ToggleSwitch x:Name="OfflineAiToggle"
                                      Header="Offline AI planner (Ollama)"
                                      OffContent="Off — rule-based only"
                                      OnContent="On — local AI plans, rule-based fallback"
                                      Toggled="OnOfflineAiToggled" />
                        <TextBlock x:Name="OfflineAiToggleHint" Style="{StaticResource VayuMutedText}" TextWrapping="Wrap"
                                   Text="Opt-in. The local model only proposes a plan — every action still passes through the permission engine. If the model is unavailable or unsure, Vayu falls back to the rule-based parser." />
                    </StackPanel>
                </Border>

                <!-- Setup wizard -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource VayuGlassCard}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="3" Height="14" Background="{StaticResource VayuAccentTealBrush}" />
                            <TextBlock Style="{StaticResource VayuSectionText}" Text="FIRST-RUN WIZARD" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource VayuBodyText}" Text="Will walk you through:" />
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="·  Ollama detection / install (with permission)" />
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="·  Gemma model download" />
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="·  Optional online provider key (Gemini, OpenAI, Anthropic, …)" />
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="·  Every step is skippable." />
                    </StackPanel>
                </Border>

                <!-- Developer mode -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource VayuGlassCard}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="3" Height="14" Background="{StaticResource VayuAccentVioletBrush}" />
                            <TextBlock Style="{StaticResource VayuSectionText}" Text="DEVELOPER MODE" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource VayuBodyText}" Text="Safe routing is enabled." />
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="·  Audit log: enabled" />
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="·  Cloud AI: disabled by default" />
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="·  Verbose logging: M2" />
                        <ToggleSwitch x:Name="VerboseToggle" IsEnabled="False" OffContent="Off" OnContent="On" />
                    </StackPanel>
                </Border>

                <!-- Future providers -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource VayuGlassCard}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="3" Height="14" Background="{StaticResource VayuAccentAmberBrush}" />
                            <TextBlock Style="{StaticResource VayuSectionText}" Text="FUTURE PROVIDERS" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Inline chip flow (StackPanel rows; no CommunityToolkit dependency) -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource VayuChip}"><TextBlock Style="{StaticResource VayuChipText}" Text="OLLAMA" /></Border>
                            <Border Style="{StaticResource VayuChipTeal}"><TextBlock Style="{StaticResource VayuChipText}" Text="GEMINI" /></Border>
                            <Border Style="{StaticResource VayuChip}"><TextBlock Style="{StaticResource VayuChipText}" Text="OPENAI" /></Border>
                            <Border Style="{StaticResource VayuChipTeal}"><TextBlock Style="{StaticResource VayuChipText}" Text="ANTHROPIC" /></Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Style="{StaticResource VayuChipViolet}"><TextBlock Style="{StaticResource VayuChipText}" Text="DEEPSEEK" /></Border>
                            <Border Style="{StaticResource VayuChipViolet}"><TextBlock Style="{StaticResource VayuChipText}" Text="KIMI" /></Border>
                            <Border Style="{StaticResource VayuChipAmber}"><TextBlock Style="{StaticResource VayuChipText}" Text="OPENROUTER" /></Border>
                            <Border Style="{StaticResource VayuChip}"><TextBlock Style="{StaticResource VayuChipText}" Text="CUSTOM OAI-COMPAT" /></Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="See docs/AI_PROVIDER_REGISTRY.md for the full M1 catalog." />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- M2.3: Offline AI status card -->
            <Border Grid.Row="2" Style="{StaticResource VayuGlassCard}">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <Border Width="3" Height="14" Background="{StaticResource VayuAccentCyanBrush}" />
                            <TextBlock Style="{StaticResource VayuSectionText}" Text="OFFLINE AI · OLLAMA" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                x:Name="RefreshOfflineAiButton"
                                Content="Refresh"
                                Click="OnRefreshOfflineAiClick" />
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource VayuMutedText}" Text="Local AI is OFF by default. Detection is read-only — no installs, no model downloads." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource VayuMutedText}" Text="Endpoint:" />
                            <TextBlock x:Name="EndpointDisplayText" Style="{StaticResource VayuBodyText}" Text="http://localhost:11434" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource VayuMutedText}" Text="Executable on PATH:" />
                            <TextBlock x:Name="ExecutableStatusText" Style="{StaticResource VayuBodyText}" Text="Not yet probed" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource VayuMutedText}" Text="Server reachable:" />
                            <TextBlock x:Name="EndpointStatusText" Style="{StaticResource VayuBodyText}" Text="Not yet probed" />
                        </StackPanel>
                        <TextBlock x:Name="DetectionMessageText" Style="{StaticResource VayuMutedText}" Text="Click Refresh to probe the local Ollama runtime." TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource VayuMutedText}" Text="Curated model catalog — install/missing reflects Ollama's /api/tags response." />
                        </StackPanel>
                        <TextBlock x:Name="CuratedSummaryText" Style="{StaticResource VayuBodyText}" Text="Installed curated models: 0 / 3" />
                        <ItemsControl x:Name="ModelsItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="svc:LocalModelRow">
                                    <Border Margin="0,4,0,4" Padding="16,12,16,12" CornerRadius="8"
                                            Background="{StaticResource VayuGlassFill}"
                                            BorderBrush="{StaticResource VayuGlassStroke}" BorderThickness="1">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Style="{StaticResource VayuBodyText}" FontSize="16" Text="{x:Bind DisplayName}" VerticalAlignment="Center" />
                                                    <TextBlock Style="{StaticResource VayuMutedText}" Text="{x:Bind ModelTag}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource VayuMutedText}" Text="{x:Bind Description}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource VayuMutedText}" Text="{x:Bind HardwareNote}" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind MetadataVisibility, Mode=OneWay}">
                                                    <Border Style="{StaticResource VayuChipTeal}"><TextBlock Style="{StaticResource VayuChipText}" Text="{x:Bind DisplaySize, Mode=OneWay}" /></Border>
                                                    <Border Style="{StaticResource VayuChip}"><TextBlock Style="{StaticResource VayuChipText}" Text="{x:Bind ParameterSize, Mode=OneWay}" /></Border>
                                                    <Border Style="{StaticResource VayuChip}"><TextBlock Style="{StaticResource VayuChipText}" Text="{x:Bind FamilyLabel, Mode=OneWay}" /></Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource VayuChip}" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource VayuChipText}" Text="{x:Bind StatusText, Mode=OneWay}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- M2.5: First Run Setup launcher -->
            <Border Grid.Row="3" Style="{StaticResource VayuGlassCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="3" Height="14" Background="{StaticResource VayuAccentTealBrush}" />
                            <TextBlock Style="{StaticResource VayuSectionText}" Text="FIRST RUN SETUP" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource VayuBodyText}" Text="Open the guided setup wizard." />
                        <TextBlock Style="{StaticResource VayuMutedText}" TextWrapping="Wrap"
                                   Text="Walks through AI mode, Ollama detection, model catalog, and a readiness verdict. M2.5 is read-only — no installs, no model downloads. M2.6 will add guided install/pull behind explicit consent." />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="OpenFirstRunSetupButton" Content="Open First Run Setup"
                            VerticalAlignment="Center" Click="OnOpenFirstRunSetupClick"
                            Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
