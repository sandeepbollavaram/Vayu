<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Vayu_Desktop.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="36,28,36,28" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="AUDIT LOGS" Style="{StaticResource VayuTitleText}" FontSize="32" />
            <TextBlock Text="Local-only record of every action Vayu took. Already redacted by the writers." Style="{StaticResource VayuSubtitleText}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <Button Style="{StaticResource VayuAccentButton}" Content="REFRESH" Click="OnRefresh" />
            <Border Style="{StaticResource VayuChipTeal}" VerticalAlignment="Center">
                <TextBlock x:Name="StatusLine" Style="{StaticResource VayuChipText}" Text="—" />
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource VayuGlassCard}" Padding="0">
            <Grid>
                <ListView x:Name="LogList"
                          ItemsSource="{x:Bind Rows, Mode=OneWay}"
                          SelectionMode="Single"
                          Background="Transparent"
                          Padding="8,4">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:AuditRow" xmlns:local="using:Vayu_Desktop.Pages">
                            <Grid Padding="14,12" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Timestamp}"
                                           Foreground="{StaticResource VayuTextMuted}"
                                           FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                           FontSize="12"
                                           VerticalAlignment="Center" />

                                <Border Grid.Column="1" Style="{StaticResource VayuChipTeal}">
                                    <TextBlock Style="{StaticResource VayuChipText}" Text="{x:Bind Risk}" />
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource VayuChip}">
                                    <TextBlock Style="{StaticResource VayuChipText}" Text="{x:Bind Decision}" />
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource VayuChipViolet}">
                                    <TextBlock Style="{StaticResource VayuChipText}" Text="{x:Bind Status}" />
                                </Border>

                                <StackPanel Grid.Column="4" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Command}"
                                               FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                               FontSize="13"
                                               Foreground="{StaticResource VayuTextPrimary}" />
                                    <TextBlock Text="{x:Bind AgentAndError}"
                                               Style="{StaticResource VayuMutedText}"
                                               FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6"
                            Visibility="Collapsed">
                    <TextBlock Style="{StaticResource VayuSectionText}"
                               HorizontalAlignment="Center"
                               Text="NO ACTIVITY YET" />
                    <TextBlock Style="{StaticResource VayuMutedText}"
                               HorizontalAlignment="Center"
                               Text="Run a command from the Home page to populate the audit log." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
