<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Vayu_Desktop.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Vayu_Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="40,28,40,32" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============== STATUS STRIP ============== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Vayu" Style="{StaticResource VayuTitleText}" FontSize="34" />
                    <TextBlock Text="local-first AI command center" Style="{StaticResource VayuSubtitleText}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Style="{StaticResource VayuChip}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource VayuAccentTealBrush}" />
                            <TextBlock x:Name="ModeChipText" Style="{StaticResource VayuChipText}" Text="AI MODE · LOCAL" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource VayuChip}">
                        <TextBlock x:Name="ProviderChipText" Style="{StaticResource VayuChipText}" Text="PROVIDER · LOCAL-FIRST" />
                    </Border>
                    <Border x:Name="RuntimeChip" Style="{StaticResource VayuChip}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse x:Name="RuntimeDot" Width="7" Height="7" Fill="{StaticResource VayuAccentTealBrush}" />
                            <TextBlock x:Name="RuntimeChipText" Style="{StaticResource VayuChipText}" Text="RUNTIME · READY" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource VayuChip}">
                        <TextBlock x:Name="VoiceChipText" Style="{StaticResource VayuChipText}" Text="VOICE · IDLE" />
                    </Border>
                    <Border Style="{StaticResource VayuChip}">
                        <TextBlock Style="{StaticResource VayuChipText}" Text="PERMISSION GUARD · ON" />
                    </Border>
                    <Border Style="{StaticResource VayuChip}">
                        <TextBlock Style="{StaticResource VayuChipText}" Text="AUDIT · LOCAL" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ============== CORE + ACTIVITY ============== -->
            <Grid Grid.Row="1" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- LEFT: sphere · command · voice · result -->
                <Border Grid.Column="0" Style="{StaticResource VayuGlassCard}" Padding="32,28">
                    <StackPanel Spacing="20">

                        <!-- Sphere -->
                        <Grid Height="300">
                            <controls:VayuSphere x:Name="Sphere" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Command input -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="CommandBox"
                                     Style="{StaticResource VayuConsoleTextBox}"
                                     PlaceholderText="Ask Vayu — or hold Push to talk and speak…"
                                     KeyDown="CommandBox_OnKeyDown" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource VayuAccentButton}"
                                    Click="OnRun"
                                    Content="Run" />
                        </Grid>

                        <!-- Voice control strip (push-to-talk + wake + enable) -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="PushToTalkButton" Content="Push to talk"
                                    Click="OnPushToTalkClick" />
                            <Button Grid.Column="1" x:Name="StopVoiceButton" Content="Stop"
                                    Click="OnStopVoiceClick" IsEnabled="False" />
                            <Border Grid.Column="2" Style="{StaticResource VayuChip}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="VoiceStateText" Style="{StaticResource VayuChipText}" Text="VOICE · IDLE" />
                            </Border>
                            <ToggleSwitch Grid.Column="3" x:Name="VoiceCommandsToggle"
                                          OffContent="Transcribe only" OnContent="Run my voice commands"
                                          Toggled="OnVoiceCommandsToggled" />
                        </Grid>
                        <!-- Hidden state badge kept for code-behind compatibility. -->
                        <Border x:Name="VoiceStateBadge" Visibility="Collapsed" />

                        <!-- Try suggestions -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource VayuMutedText}" Text="try" VerticalAlignment="Center" />
                            <Button Style="{StaticResource VayuGhostButton}" Content="open notepad" Click="OnExampleClick" Tag="open notepad" />
                            <Button Style="{StaticResource VayuGhostButton}" Content="open notepad and write hello" Click="OnExampleClick" Tag="open notepad and write hello" />
                            <Button Style="{StaticResource VayuGhostButton}" Content="show logs" Click="OnExampleClick" Tag="show logs" />
                        </StackPanel>

                        <!-- Result / transcript console -->
                        <Border x:Name="ResultCard" Style="{StaticResource VayuGlassCardElevated}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" x:Name="ResultIndicator"
                                         Width="9" Height="9"
                                         Fill="{StaticResource VayuAccentTealBrush}"
                                         VerticalAlignment="Top" Margin="0,4,0,0" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock x:Name="ResultStatus" Style="{StaticResource VayuSectionText}" Text="LAST RESULT · READY" />
                                        <TextBlock x:Name="ResultAgent" Style="{StaticResource VayuMutedText}" Text="" />
                                        <TextBlock x:Name="ResultRisk" Style="{StaticResource VayuMutedText}" Text="" />
                                    </StackPanel>
                                    <TextBlock x:Name="ResultMessage" Style="{StaticResource VayuBodyText}"
                                               Text="Type a command, press Run, or hold Push to talk and speak." />
                                    <TextBlock x:Name="VoiceTranscriptText" Style="{StaticResource VayuMutedText}" TextWrapping="Wrap"
                                               Text="" />
                                    <TextBlock x:Name="VoiceCommandResultText" Style="{StaticResource VayuMutedText}" TextWrapping="Wrap" Text="" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" x:Name="ResultTimestamp" Style="{StaticResource VayuMutedText}"
                                           VerticalAlignment="Top" Text="" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- RIGHT: activity rail -->
                <StackPanel Grid.Column="1" Spacing="14">
                    <Border Style="{StaticResource VayuGlassCard}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource VayuSectionText}" Text="NOW" />
                            <TextBlock x:Name="ActivityNowText" Style="{StaticResource VayuBodyText}" TextWrapping="Wrap"
                                       Text="Idle — waiting for a command." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource VayuGlassCard}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource VayuSectionText}" Text="VOICE" />
                            <TextBlock x:Name="VoiceMicStatusText" Style="{StaticResource VayuMutedText}" TextWrapping="Wrap" Text="Microphone: checking…" />
                            <TextBlock x:Name="VoiceSttStatusText" Style="{StaticResource VayuMutedText}" TextWrapping="Wrap" Text="Local STT: checking…" />
                            <TextBlock x:Name="VoiceTtsStatusText" Style="{StaticResource VayuMutedText}" TextWrapping="Wrap" Text="Text-to-speech: checking…" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource VayuGlassCard}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource VayuSectionText}" Text="AGENT QUEUE" />
                            <TextBlock Style="{StaticResource VayuMutedText}" TextWrapping="Wrap"
                                       Text="No agents queued. Running agents and tasks appear here with stop controls." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource VayuGlassCard}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource VayuSectionText}" Text="AI RUNTIME" />
                            <TextBlock x:Name="ProviderSummaryText" Style="{StaticResource VayuMutedText}" TextWrapping="Wrap"
                                       Text="Local-first. Local, Online, and Hybrid AI are available — choose a mode in Settings. Cloud calls ask for consent." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource VayuGlassCard}">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource VayuSectionText}" Text="TRUST GUARD" />
                            <TextBlock Style="{StaticResource VayuMutedText}" TextWrapping="Wrap"
                                       Text="Every action is permission-gated and audit-logged. Higher-risk actions ask first. Vayu never runs arbitrary commands." />
                        </StackPanel>
                    </Border>

                    <!-- Hidden TTS controls kept for code-behind compatibility. -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                        <Button x:Name="SpeakStatusButton" Content="Speak status" Click="OnSpeakStatusClick" />
                        <Button x:Name="StopSpeakingButton" Content="Stop speaking" Click="OnStopSpeakingClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ============== RECENT ACTIVITY ============== -->
            <Border Grid.Row="2" Style="{StaticResource VayuGlassCard}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Style="{StaticResource VayuSectionText}" Text="RECENT ACTIVITY" VerticalAlignment="Center" />
                        <TextBlock x:Name="RecentCountText" Style="{StaticResource VayuMutedText}" VerticalAlignment="Center" Text="" />
                    </StackPanel>
                    <ItemsControl x:Name="RecentList" ItemsSource="{x:Bind RecentRows, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" ColumnSpacing="14">
                                    <TextBlock Text="{Binding}"
                                               FontFamily="Cascadia Mono, Consolas, Segoe UI"
                                               FontSize="12"
                                               Foreground="{StaticResource VayuTextSecondary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="RecentEmpty" Style="{StaticResource VayuMutedText}"
                               Text="No audit rows yet. Run a command to populate the log." Visibility="Visible" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
