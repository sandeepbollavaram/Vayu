<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =====================================================
         Vayu visual identity. Dark, glass, electric-cyan with
         teal/blue wind accents — mirrors the Vayu app icon.
         All resources are pure XAML — no external assets.
         ===================================================== -->

    <!-- ===== Accent palette ===== -->
    <Color x:Key="VayuAccentCyan">#FF00E1FF</Color>
    <Color x:Key="VayuAccentBlue">#FF4FA8FF</Color>
    <Color x:Key="VayuAccentTeal">#FF2EE6C9</Color>
    <Color x:Key="VayuAccentVioletColor">#FF9B7BFF</Color>
    <Color x:Key="VayuAccentAmberColor">#FFFFB85C</Color>
    <Color x:Key="VayuAccentRedColor">#FFFF5C7C</Color>

    <SolidColorBrush x:Key="VayuAccentCyanBrush"   Color="{StaticResource VayuAccentCyan}" />
    <SolidColorBrush x:Key="VayuAccentBlueBrush"   Color="{StaticResource VayuAccentBlue}" />
    <SolidColorBrush x:Key="VayuAccentTealBrush"   Color="{StaticResource VayuAccentTeal}" />
    <SolidColorBrush x:Key="VayuAccentVioletBrush" Color="{StaticResource VayuAccentVioletColor}" />
    <SolidColorBrush x:Key="VayuAccentAmberBrush"  Color="{StaticResource VayuAccentAmberColor}" />
    <SolidColorBrush x:Key="VayuAccentRedBrush"    Color="{StaticResource VayuAccentRedColor}" />

    <!-- ===== Text ===== -->
    <SolidColorBrush x:Key="VayuTextPrimary"   Color="#FFE8F2FF" />
    <SolidColorBrush x:Key="VayuTextSecondary" Color="#CCBAC8DC" />
    <SolidColorBrush x:Key="VayuTextMuted"     Color="#9988A0C0" />

    <!-- ===== Surfaces (frosted glass — Mica shows through; NO gradient fills) ===== -->
    <SolidColorBrush x:Key="VayuShellBackground"   Color="#FF070B14" />
    <!-- Very low-opacity fills so the translucent Mica backdrop reads as glass. -->
    <SolidColorBrush x:Key="VayuGlassFill"         Color="#14FFFFFF" />
    <SolidColorBrush x:Key="VayuGlassFillStrong"   Color="#22FFFFFF" />
    <!-- Hairline borders only. -->
    <SolidColorBrush x:Key="VayuGlassStroke"       Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="VayuGlassStrokeStrong" Color="#33FFFFFF" />

    <!-- Core orb (flat radial glow only on the sphere itself, not a UI fill). -->
    <RadialGradientBrush x:Key="VayuCoreGlowBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#FFB6F4FF" Offset="0.0" />
        <GradientStop Color="#FF2EE6C9" Offset="0.45" />
        <GradientStop Color="#FF0A6FFF" Offset="0.85" />
        <GradientStop Color="#FF0A2050" Offset="1.0" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="VayuPulseHaloBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#9900E1FF" Offset="0.0" />
        <GradientStop Color="#0000E1FF" Offset="1.0" />
    </RadialGradientBrush>

    <!-- ===== Frosted glass panel (replaces the old solid cards) ===== -->
    <Style x:Key="VayuGlassCard" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource VayuGlassFill}" />
        <Setter Property="BorderBrush"     Value="{StaticResource VayuGlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="12" />
        <Setter Property="Padding"         Value="20" />
    </Style>

    <Style x:Key="VayuGlassCardElevated" TargetType="Border" BasedOn="{StaticResource VayuGlassCard}">
        <Setter Property="Background"  Value="{StaticResource VayuGlassFillStrong}" />
        <Setter Property="BorderBrush" Value="{StaticResource VayuGlassStrokeStrong}" />
    </Style>

    <!-- ===== Status pill — quiet glass, hairline border, neutral text ===== -->
    <Style x:Key="VayuChip" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource VayuGlassFill}" />
        <Setter Property="BorderBrush"     Value="{StaticResource VayuGlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="999" />
        <Setter Property="Padding"         Value="12,5" />
    </Style>

    <Style x:Key="VayuChipTeal" TargetType="Border" BasedOn="{StaticResource VayuChip}" />
    <Style x:Key="VayuChipViolet" TargetType="Border" BasedOn="{StaticResource VayuChip}" />
    <Style x:Key="VayuChipAmber" TargetType="Border" BasedOn="{StaticResource VayuChip}" />
    <Style x:Key="VayuChipRed" TargetType="Border" BasedOn="{StaticResource VayuChip}" />

    <Style x:Key="VayuChipText" TargetType="TextBlock">
        <Setter Property="Foreground"       Value="{StaticResource VayuTextSecondary}" />
        <Setter Property="FontSize"         Value="11" />
        <Setter Property="FontWeight"       Value="Medium" />
        <Setter Property="CharacterSpacing" Value="30" />
    </Style>

    <!-- ===== Typography ===== -->
    <Style x:Key="VayuTitleText" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="44" />
        <Setter Property="FontWeight"       Value="SemiLight" />
        <Setter Property="Foreground"       Value="{StaticResource VayuTextPrimary}" />
        <Setter Property="CharacterSpacing" Value="80" />
    </Style>

    <Style x:Key="VayuSubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="13" />
        <Setter Property="Foreground"       Value="{StaticResource VayuTextSecondary}" />
        <Setter Property="CharacterSpacing" Value="40" />
    </Style>

    <Style x:Key="VayuSectionText" TargetType="TextBlock">
        <Setter Property="FontSize"         Value="11" />
        <Setter Property="FontWeight"       Value="SemiBold" />
        <Setter Property="Foreground"       Value="{StaticResource VayuTextMuted}" />
        <Setter Property="CharacterSpacing" Value="180" />
    </Style>

    <Style x:Key="VayuBodyText" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="14" />
        <Setter Property="Foreground"  Value="{StaticResource VayuTextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="VayuMutedText" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="13" />
        <Setter Property="Foreground"  Value="{StaticResource VayuTextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===== Console TextBox ===== -->
    <Style x:Key="VayuConsoleTextBox" TargetType="TextBox">
        <Setter Property="FontFamily"      Value="Cascadia Mono, Consolas, Segoe UI" />
        <Setter Property="FontSize"        Value="15" />
        <Setter Property="Foreground"      Value="{StaticResource VayuTextPrimary}" />
        <Setter Property="Background"      Value="{StaticResource VayuGlassFillStrong}" />
        <Setter Property="BorderBrush"     Value="{StaticResource VayuGlassStrokeStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="12" />
        <Setter Property="Padding"         Value="16,13" />
        <Setter Property="MinHeight"       Value="50" />
    </Style>

    <!-- ===== Accent button ===== -->
    <Style x:Key="VayuAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight"        Value="44" />
        <Setter Property="MinWidth"         Value="110" />
        <Setter Property="FontSize"         Value="14" />
        <Setter Property="FontWeight"       Value="SemiBold" />
        <Setter Property="CornerRadius"     Value="10" />
        <Setter Property="CharacterSpacing" Value="40" />
    </Style>

    <!-- Subtle ghost button used for "example" suggestions -->
    <Style x:Key="VayuGhostButton" TargetType="Button">
        <Setter Property="Background"      Value="#220A1828" />
        <Setter Property="BorderBrush"     Value="{StaticResource VayuGlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground"      Value="{StaticResource VayuTextSecondary}" />
        <Setter Property="CornerRadius"    Value="999" />
        <Setter Property="Padding"         Value="12,4" />
        <Setter Property="MinHeight"       Value="28" />
        <Setter Property="FontSize"        Value="12" />
        <Setter Property="FontFamily"      Value="Cascadia Mono, Consolas, Segoe UI" />
    </Style>

</ResourceDictionary>
