<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Vayu_Desktop.SphereOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Vayu_Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Transparent always-on-top overlay: the desktop shows through; only the
         sphere itself is interactive (drag to move, click to open Vayu). -->
    <Grid x:Name="RootGrid" Background="Transparent"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased"
          RightTapped="OnRightTapped"
          Tapped="OnTapped">
        <controls:VayuSphere x:Name="OverlaySphere"
                             Width="140" Height="140"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Listening indicator dot (hidden unless armed/listening). -->
        <Border x:Name="ListeningDot"
                Width="14" Height="14" CornerRadius="999"
                Background="{StaticResource VayuAccentTealBrush}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,12,12,0"
                Visibility="Collapsed" />
    </Grid>
</Window>
